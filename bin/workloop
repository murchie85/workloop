#!/usr/bin/env python3
"""workloop            the menu
workloop peek ...   read what a seat said        (workloop peek -h)
workloop reg ...    change the project registry  (workloop reg -h)
workloop hook       called by Claude Code hooks; reads the hook JSON on stdin"""
import os, sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
for stream in (sys.stdout, sys.stderr):      # Windows consoles default to cp1252
    try:
        stream.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

args = sys.argv[1:]
if not args:
    from workloop.ui import main
    main()
elif args[0] in ("hook", "peek", "reg"):
    from workloop import tools
    getattr(tools, args[0])(args[1:])
else:
    sys.exit(__doc__)
